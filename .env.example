# Telegram bot that receives lead-form submissions (src/app/api/lead/route.ts).
# Create a bot via @BotFather in Telegram to get the token, then message the
# bot (or add it to a group) and read the chat id from the getUpdates response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GA4 Measurement Protocol — reports the generate_lead conversion server-side
# (src/app/api/lead/route.ts) so it isn't lost to ad blockers or consent gating.
# GA4 admin > Data streams > your stream > Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
